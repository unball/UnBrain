                <property name="margin_right">6</property>
                <property name="label" translatable="yes">Compensa sombras e iluminação desigual no campo antes de segmentar as cores, deixando os limiares HSV mais estáveis com luz variando.</property>
                <property name="wrap">True</property>
                <property name="xalign">0</property>
