  </object>
  <object class="GtkScrolledWindow" id="main"><property name="visible">True</property><property name="can_focus">True</property><property name="hscrollbar_policy">never</property><property name="vscrollbar_policy">automatic</property><child><object class="GtkViewport"><property name="visible">True</property><property name="can_focus">False</property><child><object class="GtkBox" id="content_box">
    <property name="visible">True</property>
    <property name="can_focus">False</property>
    <property name="margin_left">15</property>
    <property name="margin_right">15</property>
    <property name="margin_top">15</property>
    <property name="margin_bottom">15</property>
    <property name="orientation">vertical</property>
    <property name="spacing">3</property>
    <child>
      <object class="GtkFrame">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="hexpand">True</property>
        <property name="label_xalign">0</property>
        <property name="shadow_type">none</property>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="hexpand">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">2</property>
            <child>
              <object class="GtkAlignment">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="halign">start</property>
                <property name="left_padding">12</property>
                <child>
                  <object class="GtkSpinButton">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="max_width_chars">7</property>
                    <property name="adjustment">adj_min_area_internal_contour</property>
                    <property name="climb_rate">1</property>
                    <property name="tooltip_text" translatable="yes">Tamanho mínimo (em pixels) para uma região da cor de identificação da camisa contar como um blob de verdade. Baixo demais: ruído (reflexo, sombra, artefato de imagem) vira um blob extra e troca a identidade do robô. Alto demais: pode apagar um blob pequeno legítimo (algumas camisas têm um blob bem menor que o outro).</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="hexpand">True</property>
                <property name="margin_left">12</property>
                <property name="margin_right">6</property>
                <property name="label" translatable="yes">Filtra ruído pequeno na cor de identificação (reflexo, sombra). É isso que decide QUAL robô (0, 1 ou 2) a visão acha que está vendo — valor baixo demais deixa passar ruído que troca a identidade; alto demais pode apagar um blob legítimo pequeno.</property>
                <property name="wrap">True</property>
                <property name="xalign">0</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child type="label">
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="yes">Área mínima do contorno interno:</property>
          </object>
        </child>
      </object>
      <packing>
        <property name="expand">True</property>
        <property name="fill">True</property>
        <property name="position">0</property>
      </packing>
    </child>
    <child>
      <object class="GtkFrame">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="hexpand">True</property>
        <property name="label_xalign">0</property>
        <property name="shadow_type">none</property>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="hexpand">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">2</property>
            <child>
              <object class="GtkAlignment">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="halign">start</property>
                <property name="left_padding">12</property>
                <child>
                  <object class="GtkSpinButton">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="max_width_chars">7</property>
                    <property name="text" translatable="yes">5</property>
                    <property name="adjustment">adj_min_area_external_contour</property>
                    <property name="climb_rate">1</property>
                    <property name="value">5</property>
                    <property name="tooltip_text" translatable="yes">Tamanho mínimo (em pixels) para o contorno completo de uma camisa (não só a cor de identificação) ser considerado um robô de verdade. Filtra manchas pequenas do campo/fundo que não são robôs.</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="hexpand">True</property>
                <property name="margin_left">12</property>
                <property name="margin_right">6</property>
                <property name="label" translatable="yes">Filtra manchas pequenas do campo que não são robôs, olhando o contorno inteiro da camisa (fundo + detalhe).</property>
                <property name="wrap">True</property>
                <property name="xalign">0</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child type="label">
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="yes">Área mínima do contorno externo:</property>
          </object>
        </child>
      </object>
      <packing>
        <property name="expand">True</property>
        <property name="fill">True</property>
        <property name="position">1</property>
      </packing>
    </child>
    <child>
      <object class="GtkFrame">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="hexpand">True</property>
        <property name="label_xalign">0</property>
        <property name="shadow_type">none</property>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="hexpand">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">2</property>
            <child>
              <object class="GtkAlignment">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="halign">start</property>
                <property name="left_padding">12</property>
                <child>
                  <object class="GtkSpinButton">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="max_width_chars">7</property>
                    <property name="adjustment">adj_area_cont_rect</property>
                    <property name="climb_rate">0.01</property>
                    <property name="digits">2</property>
                    <property name="tooltip_text" translatable="yes">Limiar que decide se a forma da marcação da camisa é um triângulo ou um retângulo. Quanto mais perto de 1.0, mais "preenchido" o contorno precisa ser (em relação ao retângulo que o envolve) para contar como retângulo; abaixo disso é lido como triângulo. Essa forma + a quantidade de blobs de cor é o que identifica se o robô é o 0, 1 ou 2.</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="hexpand">True</property>
                <property name="margin_left">12</property>
                <property name="margin_right">6</property>
                <property name="label" translatable="yes">Decide se a marcação da camisa é lida como triângulo ou retângulo. Junto com a quantidade de blobs, é o que diferencia o robô 0 (1 triângulo), o 1 (2 triângulos) e o 2 (2 retângulos).</property>
                <property name="wrap">True</property>
                <property name="xalign">0</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child type="label">
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="yes">Razão área contorno/retângulo:</property>
          </object>
        </child>
      </object>
      <packing>
        <property name="expand">True</property>
        <property name="fill">True</property>
        <property name="position">2</property>
      </packing>
    </child>
