                        <property name="digits">3</property>
                        <property name="value">0.995</property>
                        <property name="tooltip_text" translatable="yes">Desativado: este controle não está ligado a nenhuma função da visão no momento (o código que o conectaria está comentado).</property>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">True</property>
                        <property name="position">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="stability_usecurrent">
