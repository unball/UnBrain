                <child>
                  <object class="GtkSwitch" id="use_clahe_switch">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="tooltip_text" translatable="yes">Aplica equalização adaptativa de contraste (CLAHE) na imagem antes da segmentação de cores, compensando sombras e iluminação desigual no campo. Ajuda os limiares de cor (HSV) a ficarem mais estáveis mesmo com luz variando.</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
